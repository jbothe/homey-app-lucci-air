{
  "id": "light",
  "name": {
    "en": "Fan light",
    "nl": "Ventilatorlamp",
    "de": "Ventilatorlampe",
    "fr": "Lampe de ventilateur"
  },
  "images": {
    "large": "/drivers/light/assets/images/large.png",
    "small": "/drivers/light/assets/images/small.png"
  },
  "class": "light",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "rf433"
  ],
  "rf433": {
    "satelliteMode": true
  },
  "capabilities": [
    "onoff",
    "dim",
    "lucci_brighter",
    "lucci_dimmer",
    "lucci_toggle"
  ],
  "capabilitiesOptions": {
    "dim": {
      "preventInsights": true
    }
  },
  "pair": [
    {
      "id": "learn",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "calibrate"
    }
  ]
}
