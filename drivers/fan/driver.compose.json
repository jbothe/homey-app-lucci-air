{
  "id": "fan",
  "name": {
    "en": "Ceiling fan",
    "nl": "Plafondventilator",
    "de": "Deckenventilator",
    "fr": "Ventilateur de plafond"
  },
  "images": {
    "small": "/drivers/fan/assets/images/small.png",
    "large": "/drivers/fan/assets/images/large.png",
    "xlarge": "/drivers/fan/assets/images/xlarge.png"
  },
  "class": "fan",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "rf433"
  ],
  "rf433": {
    "satelliteMode": true
  },
  "capabilities": [
    "onoff",
    "lucci_speed",
    "lucci_direction",
    "lucci_timer"
  ],
  "capabilitiesOptions": {
    "lucci_speed": {
      "preventInsights": true
    },
    "lucci_direction": {
      "preventInsights": true
    },
    "lucci_timer": {
      "preventInsights": true
    }
  },
  "pair": [
    {
      "id": "learn",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ]
}
