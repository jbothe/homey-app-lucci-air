{
  "id": "fan",
  "name": {
    "en": "Ceiling fan",
    "nl": "Plafondventilator",
    "de": "Deckenventilator",
    "fr": "Ventilateur de plafond"
  },
  "images": {
    "large": "/drivers/fan/assets/images/large.png",
    "small": "/drivers/fan/assets/images/small.png"
  },
  "class": "fan",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "rf433"
  ],
  "rf433": {
    "satelliteMode": true
  },
  "capabilities": [
    "onoff",
    "lucci_speed"
  ],
  "capabilitiesOptions": {
    "lucci_speed": {
      "preventInsights": true
    }
  },
  "pair": [
    {
      "id": "learn",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ]
}
